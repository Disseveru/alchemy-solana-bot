# Alchemy Solana gRPC Bot – configuration template
# Copy this file to .env and fill in your credentials.

# ── Alchemy Yellowstone gRPC endpoint ────────────────────────────────────────
# Example: https://solana-mainnet.g.alchemy.com/v2/<YOUR_API_KEY>
GRPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Authentication token sent as the "x-token" gRPC metadata header.
X_TOKEN=YOUR_X_TOKEN_HERE

# ── Solana RPC endpoint ───────────────────────────────────────────────────────
# Used for blockhash refresh, transaction simulation, and fallback broadcast.
# Recommendation: use the same Alchemy endpoint above for consistency.
RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ── Jito Block Engine ─────────────────────────────────────────────────────────
# See https://jito-labs.gitbook.io/mev/searcher-resources/block-engine
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf:443

# ── Wallet configuration (choose ONE) ────────────────────────────────────────
#
# Option A – base-58 encoded 64-byte private key (most common for bots).
#   Generate:  solana-keygen new --no-bip39-passphrase --outfile wallet.json
#   Export:    python3 -c "import json,base58; \
#                  print(base58.b58encode(bytes(json.load(open('wallet.json')))).decode())"
#
# SECURITY: Keep this value secret. Never commit it to version control.
# WALLET_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY_HERE

# Option B – path to a Solana JSON keypair file.
# WALLET_KEY_FILE=/home/user/.config/solana/id.json

# ── Arbitrage engine ──────────────────────────────────────────────────────────
#
# Set to "true" ONLY after:
#   1. Filling in all ArbRoute fields in main.rs with verified mainnet addresses.
#   2. Funding the wallet with ≥ 0.1 SOL for fees + tips.
#   3. Creating the required SPL token accounts (our_loan_token_account, etc.).
#   4. Testing with a small loan amount first.
#
# WARNING: Flash-loan arbitrage carries real financial risk. Failed bundles
# still pay Jito tips. Competition from other bots means profit is never
# guaranteed. Only run with funds you can afford to lose.
ARB_ENABLED=false

# ── Tunable strategy parameters (all optional, env overrides apply) ───────────

# Priority fee in microlamports per compute unit (default: 100_000).
# Increase during high congestion. At 100k µL/CU and 400k CUs: ~0.04 SOL/tx.
# COMPUTE_UNIT_PRICE=100000

# Jito tip per bundle in lamports (default: 100_000 = 0.0001 SOL).
# JITO_TIP_LAMPORTS=100000

# Minimum net profit to submit a bundle, in lamports (default: 50_000).
# MIN_NET_PROFIT_LAMPORTS=50000

# Minimum swap notional to trigger a backrun, in lamports (default: 1_000_000_000 = 1 SOL).
# MIN_TARGET_SWAP_LAMPORTS=1000000000

# Slippage tolerance in basis points (default: 200 = 2%).
# SLIPPAGE_BPS=200

# Solend flash-loan fee in basis points (default: 30 = 0.3%).
# SOLEND_FEE_BPS=30

# Maximum Jito submission retries on transient gRPC failures (default: 3).
# MAX_RETRY_ATTEMPTS=3

# ── Logging ───────────────────────────────────────────────────────────────────
# Set RUST_LOG=debug for verbose output during testing.
# RUST_LOG=info
